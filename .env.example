# Yellowtooths API Configuration
NEXT_PUBLIC_API_BASE_URL=https://yt.jinskadamthodu.com/public/api
NEXT_PUBLIC_MEDIA_BASE_URL=https://yt.jinskadamthodu.com/public

# Supabase Configuration (Required for dynamic admin persistence & media uploads on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary (Optional fallback for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
